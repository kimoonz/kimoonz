# ─────────────────────────────────────────────────────────────
# 텔레그램 설정
#
# 봇 토큰은 이 파일이 아니라 PC 사용자 환경변수에 두는 걸 권합니다.
# 이 폴더가 깃이나 클라우드 드라이브로 동기화돼도 토큰이 안 따라갑니다.
#
#   Windows (PowerShell, 한 번만):
#     [Environment]::SetEnvironmentVariable("TELEGRAM_BOT_TOKEN", "<토큰>", "User")
#   macOS / Linux (~/.bashrc 또는 ~/.zshrc):
#     export TELEGRAM_BOT_TOKEN="<토큰>"
#
# 이미 다른 자동화에서 TELEGRAM_BOT_TOKEN 을 쓰고 있다면 그대로 재사용됩니다.
# ─────────────────────────────────────────────────────────────

# 봇 토큰 (@BotFather 에서 /newbot 또는 /mybots -> API Token)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# 선물 신호 전용 방. 없으면 TELEGRAM_CHAT_ID 를 씁니다.
# 봇 하나로 여러 자동화를 돌린다면 전용 그룹을 하나 만드는 걸 권합니다.
# (python scripts/setup_telegram.py 로 확인)
TELEGRAM_CHAT_ID_FUTURES=

# 공용 기본 방
TELEGRAM_CHAT_ID=123456789
